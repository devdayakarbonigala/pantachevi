# Copy to .env.
# Weather source: live (default) calls Open-Meteo and falls back to the stub on any failure;
# stub always uses the fixed scripted forecast (tests and the scripted demo).
# Open-Meteo's free API is non-commercial, so check its terms before a commercial launch.
PANTACHEVI_WEATHER=live
# Leave DATABASE_URL unset to run on the in-memory store (data is lost on restart).
DATABASE_URL=postgresql://pantachevi:pantachevi_local_dev@localhost:5432/pantachevi
REDIS_URL=redis://localhost:6379/0
# Supervisor: rules (default, deterministic) or bedrock (a model writes the final wording).
# In bedrock mode any error or any disagreement with the rules falls back to rules.
# Needs boto3 (pip install boto3) and AWS access to Bedrock. Credentials come from the
# usual AWS chain or AWS_BEARER_TOKEN_BEDROCK; never put them in this file or the repo.
PANTACHEVI_SUPERVISOR=rules
AWS_REGION=us-east-1
# PANTACHEVI_BEDROCK_MODEL_ID=
# PANTACHEVI_BEDROCK_TIMEOUT=12
